# Copy to .env and fill in the two API keys. Never commit .env.
# Every variable is optional except the keys needed for live mode.

# --- Credentials (live mode only) ---
FR_API_KEY=
OPENROUTER_API_KEY=

# --- Server storage / deployment ---
# All caches, fetched reports and logs live here (mount as a volume in containers).
DATA_DIR=./server/data
# Paths baked into the server image; override only for unusual local layouts.
# COMPANIES_FILE=./server/data/companies.yaml
# PROMPTS_DIR=./server/prompts
# false = cached-only: live requests are refused and no provider credits are spent.
ALLOW_LIVE=false
# Optional Postgres for the state store (caches, reports, usage logs). Empty = files under DATA_DIR.
# For Supabase use the "Session pooler" URI from the project's Connect dialog (IPv4-reachable):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Create the schema once with: stock-analyzer db init. Never commit a real value.
DATABASE_URL=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM model roles (OpenRouter model ids) ---
MODEL_MAIN=anthropic/claude-sonnet-5.5
MODEL_CHEAP=anthropic/claude-haiku-5.5
# Max size of the report text sent with a playground question (estimated tokens).
PLAYGROUND_MAX_TOKENS=60000
LLM_MAX_TOKENS=4096
# true = answer every LLM call with the offline FakeLLM (no key, no cost).
LLM_FAKE=false
LLM_TIMEOUT_S=120

# --- Agents (company story) ---
# Model turns an agent may take (tool calls + final answer) before its run fails.
AGENT_MAX_TURNS=8
# Output tokens per agent turn (Hebrew structured output is long).
AGENT_MAX_OUTPUT_TOKENS=16000
# Model role (main / cheap) for the report-reading agents and for the storyteller.
STORY_READER_ROLE=cheap
STORY_WRITER_ROLE=main
# Report text (estimated tokens) a story run may send; larger runs are refused before any LLM call.
STORY_MAX_TOKENS=300000
# Opening business sections given to the describe agent, and each agent's reading budget (tokens).
STORY_DESCRIBE_INTRO_TOKENS=12000
STORY_READER_BUDGET_TOKENS=20000
# Changed sections per change-agent call (tokens), and the storyteller's turn limit.
STORY_CHANGE_BATCH_TOKENS=40000
STORY_WRITER_MAX_TURNS=20

# --- Report comparison across years (see server/docs/diff_notes.md) ---
# Section text similarity (0..1) at or above which a section counts as unchanged.
DIFF_UNCHANGED_THRESHOLD=0.95
# Title match score (0..100) for aligning a renamed section.
DIFF_TITLE_MATCH_THRESHOLD=85
# Text similarity (0..1) that aligns a section whose title did not match.
DIFF_CONTENT_MATCH_THRESHOLD=0.6

# --- OSINT research (stock-analyzer osint TICKER) ---
# Model for the research agents (OpenRouter id). Web searches use MODEL_CHEAP with the Exa engine.
MODEL_OSINT=openai/gpt-6.1-sol
# Web searches allowed per run (about $0.007 each), results per search, model turns per agent.
OSINT_MAX_SEARCHES=40
OSINT_SEARCH_RESULTS=8
OSINT_MAX_TURNS=12
# Default research window in months: the present plus the past few years. Every run searches live.
OSINT_WINDOW_MONTHS=36

# --- FinancialFilings provider ---
FR_BASE_URL=https://api.financialreports.eu
FR_MAX_ATTEMPTS=5
FR_BACKOFF_BASE_S=1.0
FR_BACKOFF_MAX_S=60
FR_TIMEOUT_S=60
FR_MARKDOWN_PAGE_CHARS=200000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Report parsing thresholds (plan.md §1.4-1.5) ---
TOC_MATCH_THRESHOLD=85
CHAPTER_MATCH_THRESHOLD=85
REPEATED_LINE_RATIO=0.30
REPEATED_LINE_MIN_PAGES=4
# A line at the top or bottom edge of at least this many pages is a running header/footer.
RUNNING_LINE_MIN_PAGES=4
MIN_BUSINESS_SECTIONS=10
GLUED_TITLE_MAX_CHARS=120
CHARS_PER_TOKEN=3.0

# --- Financial data ---
FIN_MAX_YEARS=5

# --- Web client ---
# Runtime API location written into /config.js by the web container.
API_BASE_URL=http://localhost:8000
# Build-time fallback for `npm run dev`.
VITE_API_BASE_URL=http://localhost:8000
