{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uv",
        "--directory",
        "server",
        "run",
        "--env-file",
        "../.env",
        "--env-file",
        ".env.demo",
        "uvicorn",
        "stock_analyzer.api.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}